# Copy to .env, fill in, and `source .env` (never commit .env; it is gitignored).
# Only the variables for the target you use are needed. DuckDB (the default) needs none.

# Databricks: databricks/RUNBOOK.md
export DATABRICKS_HOST=dbc-xxxxxxxx-xxxx.cloud.databricks.com
export DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
export DATABRICKS_CATALOG=workspace
export DATABRICKS_SCHEMA=default
# export DATABRICKS_TOKEN=dapi...            # only for the databricks_token target (no browser available)

# Snowflake: snowflake/RUNBOOK.md
export SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
export SNOWFLAKE_USER=YOUR_USER_NAME
export SNOWFLAKE_PRIVATE_KEY_PATH="$HOME/.snowflake/rsa_key.p8"
export SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# export SNOWFLAKE_PASSWORD=...              # only for the snowflake_password target (trial accounts)
# SNOWFLAKE_ROLE, _WAREHOUSE, _DATABASE and _SCHEMA default to what snowflake/setup.sql creates

export DBT_SEND_ANONYMOUS_USAGE_STATS=false
